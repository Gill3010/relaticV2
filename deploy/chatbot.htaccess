DirectoryIndex index.html
Options -Indexes

# Sirve index.html local de /chatbot/ (metadatos Open Graph UTE).
# El backend en /chatbot/backend/ no se reescribe.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /chatbot/

  RewriteRule ^backend(/|$) - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^.*$ index.html [L]
</IfModule>
